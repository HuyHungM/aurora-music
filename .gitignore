# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Bun is the only package manager (see AGENTS.md "Toolchain"). `bun.lock` is
# committed on purpose — it is the sole dependency authority. There are
# deliberately NO ignore entries for `package-lock.json`, `yarn.lock`,
# `pnpm-lock.yaml`, `.pnp*`, `.yarn/*` or the npm/yarn/pnpm debug logs: those
# package managers are out of scope, so if one is ever run by accident its
# lockfile and logs must show up as untracked files rather than being silently
# hidden. Two lockfiles that quietly disagree are the failure mode this
# repository is avoiding.
# dependencies
/node_modules

# testing
/coverage
/test-results
/playwright-report
# generated Playwright browser auth state (test session cookies only)
e2e/.auth/

# next.js
/.next/
/out/

# OpenNext for Cloudflare (see docs/deployment.md)
/.open-next/
/.wrangler/
# wrangler's local dev secret file; never commit values, only the template
/.dev.vars*
!/.dev.vars.example
# generated by `bun run cf-typegen`
/cloudflare-env.d.ts

# local QA scaffolding (screenshots, probes, minted session tokens); never
# commit — `.qa/auth-*.json` holds live test-session cookies.
/.qa/
/.qa-*.mts

# local build/test/debug dumps written by ad-hoc commands (e.g. build.out,
# dbtest.out, lint.out, test.out, typecheck.out, opennext-run.out); never
# commit — these are scratch output, not artifacts.
/*.out

# production
/build

# misc
.DS_Store
*.pem

# debug
# No npm/yarn/pnpm debug-log entries: those package managers are not used
# (see the note at the top of this file).

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated prisma client
/src/generated

# local databases
*.db
*.db-journal
*.sqlite

// Cloudflare Workers configuration for the OpenNext adapter.
//
// Committed and stable: the Cloudflare build must not depend on
// `wrangler deploy` auto-migrating the project. Keep `main`/`assets` pointed
// at the paths `opennextjs-cloudflare build` produces (`.open-next/...`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurora-music",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // `nodejs_compat` is required by pg, @prisma/adapter-pg and Auth.js.
  // `global_fetch_strictly_public` keeps the Node fetch shim from re-entering
  // the Worker (recommended by the OpenNext adapter).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Non-secret runtime variables. `AURORA_PUBLIC_URL` is the canonical
  // production origin and the single source of truth for Auth.js callbacks and
  // absolute URLs. Secrets are never listed here — set them with
  // `wrangler secret put` (see docs/deployment.md).
  "vars": {
    "AURORA_PUBLIC_URL": "https://app.auroramuzik.dpdns.org",
    "AUTH_TRUST_HOST": "true"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    // Enables optimised next/image delivery via Cloudflare Images.
    "binding": "IMAGES"
  }
}

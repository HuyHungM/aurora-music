generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(cuid())
  email          String?          @unique
  name           String?
  emailVerified  DateTime?
  image          String?
  locale         String?
  /// Phase 53 "Aurora Glass": the appearance preference, as the compact
  /// versioned document `src/lib/appearance/appearance.ts` encodes. Nullable
  /// column only, like `locale`: null means "no explicit preference" and
  /// falls back to the anonymous cookie, then to `DEFAULT_APPEARANCE`. No
  /// backfill, no default, and deliberately NOT part of `PlaybackState` -
  /// appearance and playback session are two lifecycles, and resetting one
  /// must never touch the other.
  appearance     Json?
  /// Phase 47 "Keep listening": generic queue continuation preference.
  /// Defaults OFF so the documented end-of-queue stop behaviour is
  /// preserved until a listener opts in. Radio remains independent.
  keepListening  Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  accounts       Account[]
  sessions       Session[]
  likes          Like[]
  follows        Follow[]
  recentlyPlayed RecentlyPlayed[]
  searchHistory  SearchHistory[]
  playlists      Playlist[]
  playbackState  PlaybackState?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Artist {
  id               String   @id @default(cuid())
  provider         String
  providerArtistId String
  name             String
  image            String?
  bio              String?
  genres           Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  albums           Album[]
  tracks           Track[]
  follows          Follow[]

  @@unique([provider, providerArtistId])
  @@index([name])
  @@index([provider])
}

model Album {
  id              String   @id @default(cuid())
  provider        String
  providerAlbumId String
  name            String
  artistId        String
  artist          Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  image           String?
  releaseDate     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tracks          Track[]

  @@unique([provider, providerAlbumId])
  @@index([artistId])
  @@index([provider])
}

model Track {
  id              String           @id @default(cuid())
  provider        String
  providerTrackId String
  title           String
  artistId        String
  artist          Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  albumId         String?
  album           Album?           @relation(fields: [albumId], references: [id], onDelete: SetNull)
  duration        Int?
  artworkUrl      String?
  streamUrl       String?
  previewUrl      String?
  genres          Json?
  releaseDate     String?
  providerUrl     String?
  explicit        Boolean?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  playlistTracks  PlaylistTrack[]
  likes           Like[]
  recentPlays     RecentlyPlayed[]

  @@unique([provider, providerTrackId])
  @@index([artistId])
  @@index([albumId])
  @@index([title])
  @@index([provider])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, trackId])
  // Leads with the sort column so the newest-first reads (`listUserLikes`,
  // `ORDER BY createdAt DESC`) are index-ordered instead of sorted over the
  // user's whole like history before `LIMIT` applies. Also serves every plain
  // `WHERE userId = ?`, so it replaces a `@@index([userId])` here rather than
  // sitting beside it. Mirrors `RecentlyPlayed`'s `(userId, playedAt)`.
  @@index([userId, createdAt])
}

model Follow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, artistId])
  // As on `Like`: recency-ordered reads need the sort column in the index.
  @@index([userId, createdAt])
}

/// ONE ROW PER (user, track): the current "when did this listener last play
/// this" state, not a play-event log. Replaying a track must move it to the
/// newest position, not append a second row, so the constraint is what makes
/// the recency list correct rather than merely de-duplicated at read time.
/// `Like` and `Follow` already carry the equivalent uniqueness for the same
/// reason. Cross-provider representations of one recording are two `Track`
/// rows and are collapsed in the DAL, which is the only layer that can run
/// the canonical matcher.
model RecentlyPlayed {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId  String
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  playedAt DateTime @default(now())

  @@unique([userId, trackId])
  @@index([userId, playedAt])
}

model SearchHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query      String
  searchedAt DateTime @default(now())

  @@index([userId, searchedAt])
}

model Playlist {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// Phase 47 reuses this existing URL column for custom artwork
  /// (no second artwork field). Null renders the default artwork.
  artwork     String?
  /// Phase 47 sharing: "private" | "shared". A shared playlist is
  /// readable through its shareToken only; never through its id.
  visibility  String          @default("private")
  /// 192-bit URL-safe token, minted server-side. Carries no database
  /// primary key, owner id, or provider id. Null while private.
  shareToken  String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tracks      PlaylistTrack[]

  @@index([userId])
  @@index([visibility])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int
  addedAt    DateTime @default(now())

  @@unique([playlistId, trackId])
  @@unique([playlistId, position])
  @@index([playlistId, position])
}

model PlaybackState {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  providerTrackId String
  position        Int
  revision        Int      @default(0)
  queueSnapshot   Json?
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

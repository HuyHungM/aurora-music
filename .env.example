# Database connection (PostgreSQL required). This file describes the LOCAL
# development database. Production runs on Neon and is configured by the Neon
# Vercel integration, not by hand - see docs/deployment.md.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aurora"

# LOCAL DEVELOPMENT ONLY. Absolute path to a PEM file holding the PostgreSQL
# provider's CA certificate(s). Needed only when the server chain ends at a
# private CA the runtime's system trust store does not contain - the failure
# is `self-signed certificate in certificate chain`. The file holds the PUBLIC
# certificate (or bundle) and no private key; keep it outside the repository.
#
# The local Aiven database needs this; Neon (production) presents a publicly
# -trusted certificate and does NOT. Never set either CA variable in a deployed
# environment - an unrelated CA cannot validate a Neon certificate and would
# break the connection.
#
#   AURORA_DATABASE_CA_CERT_PATH="/etc/aurora/postgres-ca.pem"
#
# When set, TLS keeps certificate and hostname verification ON and adds this
# CA as a trust anchor. When unset, the connection is used exactly as
# DATABASE_URL wrote it, verified against the system trust store. Never
# disable verification to work around a certificate problem.
AURORA_DATABASE_CA_CERT_PATH=

# Filesystem-less alternative to the path above: the SAME public CA
# certificate(s) as inline PEM text, for a runtime with no readable file. No
# current Aurora runtime needs this - Vercel talks to Neon (publicly trusted)
# and the local Aiven database is reached from a host that can read a file. It
# is kept because it is a working trust-anchor mechanism, not because a current
# deployment depends on it. Takes precedence over the path; carries no private
# key and never weakens verification.
#   AURORA_DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
AURORA_DATABASE_CA_CERT=

# Required in production only (Auth.js). In development a dev secret is used.
AUTH_SECRET=

# Optional â€” enables Google OAuth sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional â€” enables GitHub OAuth sign-in.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional â€” the PUBLIC origin users and OAuth providers reach Aurora on.
# Auth.js builds every absolute URL it emits (the Google `redirect_uri` above
# all) from this, so a deployment behind a tunnel or reverse proxy must set it:
#   AURORA_PUBLIC_URL="https://app.auroramuzik.dpdns.org"
# Must be a bare http(s) origin â€” no path, query, fragment or credentials.
#
# This is NOT the origin the process listens on. That one is internal (e.g. a
# loopback port, or Vercel's own per-deployment hostname) and must never appear
# here: carrying its port into the callback is what makes Google reject the
# sign-in with `redirect_uri_mismatch`, because the registered URI has no port.
#
# Unset = the origin comes from the request headers, which is what localhost
# and LAN development need, and which makes the app dependent on the proxy
# setting Host correctly. If you also set AUTH_URL or NEXTAUTH_URL, it must
# name the same origin or the server refuses to boot.
AURORA_PUBLIC_URL=

# Optional, server-only â€” enables the YouTube metadata provider
# (search/track/artist/playlist lookup via YouTube Data API v3).
# Never expose as NEXT_PUBLIC_*. Absent = YouTube stays unregistered.
YOUTUBE_API_KEY=

# Optional, server-only - forward proxy for the shared YouTube InnerTube
# egress (discovery + playback). Set it when this runtime's egress IP is
# treated as a datacenter and YouTube answers the player request with
# LOGIN_REQUIRED ("Sign in to confirm you're not a bot") and no streaming
# data, so playback fails with "No playable audio format available".
# Only InnerTube traffic is proxied; nothing else, and never user traffic.
# May embed credentials:
#   AURORA_YOUTUBE_EGRESS_PROXY="http://user:pass@proxy.example:8080"
# Must be an absolute http(s) URL (HTTP CONNECT); socks is not supported.
# Unset or empty = direct egress, exactly as before. Never NEXT_PUBLIC_*.
AURORA_YOUTUBE_EGRESS_PROXY=

# Optional, server-only â€” enables the Spotify catalog provider via
# Client Credentials (no user data). Both required together; never
# NEXT_PUBLIC_*. Absent = Spotify stays unregistered.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional, server-only - comma-separated feature-flag overrides.
#   AURORA_FEATURE_FLAGS="radio=0,playlistSharing=0"
# Names, defaults, owners and risk ratings are declared in
# src/lib/feature-flags.ts; that registry is the documentation. Parsing never
# throws, so a typo is ignored rather than fatal. "playlistSharing" blocks the
# transition TO shared only - going back to private is always permitted, so
# revocation keeps working while the feature is being killed.
AURORA_FEATURE_FLAGS=

# Dev-only, read by next.config.ts (never by the application): hosts the dev
# server may be opened from in addition to loopback, so another device on the
# LAN can load /_next/hmr and /__nextjs_font instead of being refused 403.
#   AURORA_DEV_ORIGINS="192.168.1.32 100.70.150.45"
# Unset = this machine's non-internal interface addresses are detected
# automatically. Set to empty = loopback only, which is why this line stays
# commented out: copying an empty value into .env would quietly close LAN
# access again. A bare "*" is refused. Development only - a production build
# never carries a dev allowlist.
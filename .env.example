# Database connection (PostgreSQL required):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aurora"

# Required in production only (Auth.js). In development a dev secret is used.
AUTH_SECRET=

# Optional â€” enables Google OAuth sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional â€” enables GitHub OAuth sign-in.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional â€” the PUBLIC origin users and OAuth providers reach Aurora on.
# Auth.js builds every absolute URL it emits (the Google `redirect_uri` above
# all) from this, so a deployment behind a tunnel or reverse proxy must set it:
#   AURORA_PUBLIC_URL="https://auroramuzik.dpdns.org"
# Must be a bare http(s) origin â€” no path, query, fragment or credentials.
#
# This is NOT the origin the process listens on. That one is internal
# (e.g. http://127.0.0.1:24584) and must never appear here: carrying its port
# into the callback is what makes Google reject the sign-in with
# `redirect_uri_mismatch`, because the registered URI has no port.
#
# Unset = the origin comes from the request headers, which is what localhost
# and LAN development need, and which makes the app dependent on the proxy
# setting Host correctly. If you also set AUTH_URL or NEXTAUTH_URL, it must
# name the same origin or the server refuses to boot.
AURORA_PUBLIC_URL=

# Optional, server-only â€” enables the YouTube metadata provider
# (search/track/artist/playlist lookup via YouTube Data API v3).
# Never expose as NEXT_PUBLIC_*. Absent = YouTube stays unregistered.
YOUTUBE_API_KEY=

# Optional, server-only â€” enables the Spotify catalog provider via
# Client Credentials (no user data). Both required together; never
# NEXT_PUBLIC_*. Absent = Spotify stays unregistered.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional, server-only - comma-separated feature-flag overrides.
#   AURORA_FEATURE_FLAGS="radio=0,playlistSharing=0"
# Names, defaults, owners and risk ratings are declared in
# src/lib/feature-flags.ts; that registry is the documentation. Parsing never
# throws, so a typo is ignored rather than fatal. "playlistSharing" blocks the
# transition TO shared only - going back to private is always permitted, so
# revocation keeps working while the feature is being killed.
AURORA_FEATURE_FLAGS=

# Dev-only, read by next.config.ts (never by the application): hosts the dev
# server may be opened from in addition to loopback, so another device on the
# LAN can load /_next/hmr and /__nextjs_font instead of being refused 403.
#   AURORA_DEV_ORIGINS="192.168.1.32 100.70.150.45"
# Unset = this machine's non-internal interface addresses are detected
# automatically. Set to empty = loopback only, which is why this line stays
# commented out: copying an empty value into .env would quietly close LAN
# access again. A bare "*" is refused. Development only - a production build
# never carries a dev allowlist.